# Supabase (backend uses the service role key -- bypasses RLS, never ship this to the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM
ANTHROPIC_API_KEY=
# Model used for mechanical steps: query generation, re-rank scoring
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Model used for planning, drafting, evaluation, channel adaptation
ANTHROPIC_MODEL_STRONG=claude-sonnet-5

# Embeddings (Voyage AI -- Claude has no embeddings endpoint)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# Research / retrieval
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@example.com

# Publishing
BUFFER_ACCESS_TOKEN=
# Buffer profile ids for the connected LinkedIn/X accounts (Buffer's API
# publishes to a "profile", not a raw platform account). Leave blank if that
# channel isn't wired up yet -- the publishing worker fails just that item,
# loudly, rather than refusing to boot.
BUFFER_PROFILE_ID_LINKEDIN=
BUFFER_PROFILE_ID_X=

# Worker
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=3000
WORKER_MAX_ATTEMPTS=3
